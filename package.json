{
  "name": "discord-local-desktop",
  "version": "4.3.3",
  "private": true,
  "description": "Electron desktop shell for the existing local Flask application.",
  "main": "desktop/main.cjs",
  "homepage": "https://aeliteestrangeira.github.io/discord/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aeliteestrangeira/discord.git"
  },
  "scripts": {
    "desktop:start": "electron desktop/main.cjs",
    "desktop:check": "node --check desktop/main.cjs && node --check desktop/backend.cjs && node --check desktop/security.cjs && node --check desktop/preload.cjs && node --check desktop/updater.cjs",
    "desktop:dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.aeliteestrangeira.discorddesktop",
    "productName": "Discord Desktop",
    "asar": true,
    "compression": "maximum",
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "output": "out"
    },
    "files": [
      "desktop/**/*.cjs",
      "package.json",
      "!desktop/packaged_setup.ps1",
      "!desktop/build_backend.ps1"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "priv/scripts/ensure_local_hostname.ps1",
        "to": "runtime/ensure_local_hostname.ps1"
      },
      {
        "from": "desktop/packaged_setup.ps1",
        "to": "runtime/packaged_setup.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Discord-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discord Desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aeliteestrangeira",
        "repo": "discord",
        "releaseType": "release"
      }
    ]
  }
}
